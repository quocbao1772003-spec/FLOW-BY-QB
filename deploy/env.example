# Copy to ../.env next to docker-compose.yml and fill in.

# First admin, created on first start if no user exists yet.
# Log in with these, then change the password in the app.
FLOWBOARD_ADMIN_USER=admin
FLOWBOARD_ADMIN_PASSWORD=change-me-now

# Public address of the app (Cloudflare hostname). Lets the browser UI call
# the API from that origin.
FLOWBOARD_ALLOWED_ORIGINS=https://flow.example.com

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token.
TUNNEL_TOKEN=

# Optional: AI planner / auto prompt. "mock" turns it off on the server.
# FLOWBOARD_PLANNER_BACKEND=auto

# AI features (Auto-Prompt, Vision, Planner) use the Claude Code CLI inside
# the container. On your PC run:  claude setup-token   and paste the token:
CLAUDE_CODE_OAUTH_TOKEN=
